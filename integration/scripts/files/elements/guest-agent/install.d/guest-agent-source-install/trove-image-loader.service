[Unit]
Description=OpenStack Trove image loader Service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
# Only written when controller_address is set, which is for development.
EnvironmentFile=-/etc/trove/controller.conf
ExecStart=/usr/local/sbin/trove-image-loader

[Install]
WantedBy=multi-user.target
