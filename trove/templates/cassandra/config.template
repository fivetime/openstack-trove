# Cassandra configuration rendered by Trove for an instance with
# {{ flavor['ram'] }} MB of memory.
#
# Only what Trove decides is here; the server uses its defaults for the
# rest. The guest agent adds the name of the cluster, the addresses, the
# seeds, the snitch, the directories and authentication on top.
num_tokens: 16
partitioner: org.apache.cassandra.dht.Murmur3Partitioner
role_manager: org.apache.cassandra.auth.CassandraRoleManager
commitlog_sync: periodic
commitlog_sync_period: 10000ms
