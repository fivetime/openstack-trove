port 6379
protected-mode no
unixsocket /var/run/valkey/valkey.sock
unixsocketperm 777
dir /var/lib/valkey

# Every write reaches the append only file within a second, so that a
# power loss keeps all but the last second; with the RDB snapshots alone
# it could lose up to an hour. The guest agent writes the file from an
# RDB-only data directory (a backup) before the server loads it.
appendonly yes
appendfsync everysec
include /etc/valkey/conf.d/index.conf
